<?xml version="1.0" encoding="UTF-8"?>

<wsdl:definitions
        xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
        xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        xmlns:tns="https://group1.system/alarm-service"
        targetNamespace="https://group1.system/alarm-service"
        name="AlarmService">

    <wsdl:types>
        <xs:schema
                targetNamespace="https://group1.system/alarm-service"
                elementFormDefault="qualified">

            <!-- Measurement received by Alarm Service -->
            <xs:element name="EvaluateMeasurementRequest">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="MeasurementId" type="xs:string"/>
                        <xs:element name="DeviceId" type="xs:string"/>
                        <xs:element name="MeasuredAt" type="xs:dateTime"/>
                        <xs:element name="Value" type="xs:decimal"/>
                        <xs:element name="MeasurementType" type="xs:string"/>
                        <xs:element name="Unit" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <!-- Alarm stored in memory when a configured threshold is exceeded -->
            <xs:complexType name="AlarmResult">
                <xs:sequence>
                    <xs:element name="AlarmCreated" type="xs:string"/>
                    <xs:element name="DeviceId" type="xs:string"/>
                    <xs:element name="CreatedAt" type="xs:dateTime"/>
                    <xs:element name="Message" type="xs:string"/>

                    <!-- Measurement that triggered this alarm -->
                    <xs:element name="MeasurementId" type="xs:string"/>
                    <xs:element name="MeasuredAt" type="xs:dateTime"/>
                    <xs:element name="Value" type="xs:decimal"/>
                    <xs:element name="MeasurementType" type="xs:string"/>
                    <xs:element name="Unit" type="xs:string"/>
                </xs:sequence>
            </xs:complexType>

            <xs:element name="EvaluateMeasurementResponse">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="AlarmCreated" type="xs:boolean"/>
                        <xs:element
                                name="Alarm"
                                type="tns:AlarmResult"
                                minOccurs="0"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <!-- Request alarms associated with a specific device -->
            <xs:element name="GetAlarmsByDeviceIdRequest">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="DeviceId" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="GetAlarmsByDeviceIdResponse">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Alarm" type="tns:AlarmResult" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <!-- Request all stored alarms -->
            <xs:element name="GetAllAlarmsRequest">
                <xs:complexType>
                    <xs:sequence/>
                </xs:complexType>
            </xs:element>

            <xs:element name="GetAllAlarmsResponse">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Alarm" type="tns:AlarmResult" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <!-- Technical/service fault -->
            <xs:element name="InternalServiceFault">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Message" type="xs:string"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

        </xs:schema>
    </wsdl:types>

    <!-- Messages -->
    <wsdl:message name="EvaluateMeasurementRequestMessage">
        <wsdl:part name="parameters" element="tns:EvaluateMeasurementRequest"/>
    </wsdl:message>

    <wsdl:message name="EvaluateMeasurementResponseMessage">
        <wsdl:part name="parameters" element="tns:EvaluateMeasurementResponse"/>
    </wsdl:message>

    <wsdl:message name="GetAlarmsByDeviceIdRequestMessage">
        <wsdl:part name="parameters" element="tns:GetAlarmsByDeviceIdRequest"/>
    </wsdl:message>

    <wsdl:message name="GetAlarmsByDeviceIdResponseMessage">
        <wsdl:part name="parameters" element="tns:GetAlarmsByDeviceIdResponse"/>
    </wsdl:message>

    <wsdl:message name="GetAllAlarmsRequestMessage">
        <wsdl:part name="parameters" element="tns:GetAllAlarmsRequest"/>
    </wsdl:message>

    <wsdl:message name="GetAllAlarmsResponseMessage">
        <wsdl:part name="parameters" element="tns:GetAllAlarmsResponse"/>
    </wsdl:message>

    <wsdl:message name="InternalServiceFaultMessage">
        <wsdl:part name="fault" element="tns:InternalServiceFault"/>
    </wsdl:message>

    <!-- Port type -->
    <wsdl:portType name="AlarmServicePortType">
        <wsdl:operation name="EvaluateMeasurement">
            <wsdl:input message="tns:EvaluateMeasurementRequestMessage"/>
            <wsdl:output message="tns:EvaluateMeasurementResponseMessage"/>
            <wsdl:fault name="InternalServiceFault" message="tns:InternalServiceFaultMessage"/>
        </wsdl:operation>

        <wsdl:operation name="GetAlarmsByDeviceId">
            <wsdl:input message="tns:GetAlarmsByDeviceIdRequestMessage"/>
            <wsdl:output message="tns:GetAlarmsByDeviceIdResponseMessage"/>
            <wsdl:fault name="InternalServiceFault" message="tns:InternalServiceFaultMessage"/>
        </wsdl:operation>

        <wsdl:operation name="GetAllAlarms">
            <wsdl:input message="tns:GetAllAlarmsRequestMessage"/>
            <wsdl:output message="tns:GetAllAlarmsResponseMessage"/>
            <wsdl:fault name="InternalServiceFault" message="tns:InternalServiceFaultMessage"/>
        </wsdl:operation>
    </wsdl:portType>

    <!-- SOAP binding -->
    <wsdl:binding name="AlarmServiceSoapBinding" type="tns:AlarmServicePortType">

        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>

        <wsdl:operation name="EvaluateMeasurement">
            <soap:operation soapAction="https://group1.system/alarm-service/EvaluateMeasurement"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input>
            <wsdl:output><soap:body use="literal"/></wsdl:output>
            <wsdl:fault name="InternalServiceFault">
                <soap:fault name="InternalServiceFault" use="literal"/>
            </wsdl:fault>
        </wsdl:operation>

        <wsdl:operation name="GetAlarmsByDeviceId">
            <soap:operation soapAction="https://group1.system/alarm-service/GetAlarmsByDeviceId"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input>
            <wsdl:output><soap:body use="literal"/></wsdl:output>
            <wsdl:fault name="InternalServiceFault">
                <soap:fault name="InternalServiceFault" use="literal"/>
            </wsdl:fault>
        </wsdl:operation>

        <wsdl:operation name="GetAllAlarms">
            <soap:operation soapAction="https://group1.system/alarm-service/GetAllAlarms"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input>
            <wsdl:output><soap:body use="literal"/></wsdl:output>
            <wsdl:fault name="InternalServiceFault">
                <soap:fault name="InternalServiceFault" use="literal"/>
            </wsdl:fault>
        </wsdl:operation>

    </wsdl:binding>

    <!-- Service -->
    <wsdl:service name="AlarmService">
        <wsdl:port name="AlarmServicePort" binding="tns:AlarmServiceSoapBinding">
            <soap:address location="http://localhost:8093/services/alarms"/>
        </wsdl:port>
    </wsdl:service>

</wsdl:definitions>
